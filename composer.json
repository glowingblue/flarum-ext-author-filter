{
    "name": "glowingblue/author-filter",
    "description": "Filter discussions by the discussion author",
    "keywords": [
        "flarum"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "flarum/core": "^2.0.0"
    },
    "replace": {
        "blomstra/user-filter": "*"
    },
    "authors": [
        {
            "name": "Team Blomstra",
            "email": "development@blomstra.net",
            "role": "Developer"
        },
        {
            "name": "Glowing Blue AG",
            "email": "dev@glowingblue.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/glowingblue/flarum-ext-author-filter/issues",
        "source": "https://github.com/glowingblue/flarum-ext-author-filter",
        "forum": "https://discuss.flarum.org/d/39420-gb-author-filter"
    },
    "autoload": {
        "psr-4": {
            "GlowingBlue\\AuthorFilter\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "GB Author Filter",
            "category": "feature",
            "icon": {
                "name": "fas fa-users-cog",
                "backgroundColor": "#00a7e3",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": true,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": false
            }
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "GlowingBlue\\AuthorFilter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis",
        "test": "Runs all tests.",
        "test:unit": "Runs all unit tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once."
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0",
        "flarum/testing": "^2.0.0"
    }
}