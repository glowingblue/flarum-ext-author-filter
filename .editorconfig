# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs
# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
max_line_length = 100
insert_final_newline = true
trim_trailing_whitespace = true
quote_type = single
indent_style = tab
indent_size = 4

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2
insert_final_newline = false
